# ==============================================================================
# Universal AI Video Production Studio - Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` or `.env.local` and set your local keys.
# NEVER commit your real `.env` or `.env.local` to version control.
# ==============================================================================

# General Platform Settings
STUDIO_ENV=development
STUDIO_DEBUG=true
STUDIO_LOG_LEVEL=INFO
STUDIO_LOG_FORMAT=console

# Workspaces and Storage Paths
# STUDIO_DATA_DIR: Master external data directory for production/runtime data separation (Task 3.9).
# If set, channels, database, temporary files, and exports default to subdirectories inside it.
# STUDIO_DATA_DIR=./data
STUDIO_WORKSPACE_ROOT=./workspace
STUDIO_CHANNELS_ROOT=./channels
STUDIO_GLOBAL_TEMPLATES_ROOT=./global_templates

# Unified Storage Provider Configuration (local, future s3, r2)
STUDIO_STORAGE_DEFAULT_PROVIDER=local
# AWS_S3_BUCKET=
# AWS_S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_ENDPOINT_URL=

# Database Settings (SQLite in MVP)
STUDIO_DB_PATH=./workspace/runtime/studio.db
STUDIO_DB_BUSY_TIMEOUT_MS=10000

# Audio Rendering Defaults
STUDIO_DEFAULT_TRUE_PEAK_DBTP=-1.0
STUDIO_DEFAULT_TARGET_LUFS=-14.0
STUDIO_DEFAULT_DUCKING_DB=-14.0

# External AI Provider API Keys (Set as needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
KLING_API_KEY=
FAL_KEY=
REPLICATE_API_TOKEN=

# FFmpeg Executable Override (Leave empty if available on system PATH)
FFMPEG_BINARY_PATH=
FFPROBE_BINARY_PATH=

